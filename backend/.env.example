# NyayaSetu AI Backend Environment Configuration
APP_NAME="NyayaSetu AI — Multilingual Family Law Information System"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api

HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated for multiple origins)
# Only allow your Vite local development server during development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG & Vector Database Settings
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=nyayasetu_legal_corpus
PROCESSED_DATA_DIR=data/processed
DEFAULT_TOP_K=5
MIN_SIMILARITY_SCORE=0.25

# Step 4: LLM Provider Configuration
# Options: 'template' (default; zero external API keys needed), 'ollama', 'openai', 'gemini'
LLM_PROVIDER=template
# LLM_API_KEY=your_api_key_here
# LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=llama3.2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
OLLAMA_BASE_URL=http://localhost:11434
LLM_REQUEST_TIMEOUT=30.0

